{
  "name": "palantir-for-family-trips",
  "version": "1.0.0",
  "type": "module",
  "description": "A Palantir-style family trip command center for a Yosemite weekend.",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev worker/index.ts --local --port 8787",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:worker": "vitest run -c vitest.worker.config.ts",
    "cf:build": "npm run typecheck && npm run typecheck:worker && npm run test && npm run test:worker && npm run build",
    "cf:deploy": "wrangler deploy"
  },
  "keywords": [
    "react",
    "vite",
    "google-maps",
    "dashboard",
    "trip-planner"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.0.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260630.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.9",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.7",
    "vitest": "^4.1.9",
    "wrangler": "^4.105.0"
  }
}
